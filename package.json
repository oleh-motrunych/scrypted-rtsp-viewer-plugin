{
  "name": "scrypted-rtsp-viewer",
  "version": "0.1.8",
  "description": "Live camera grid and spotlight viewer using existing Scrypted camera streams.",
  "author": {
    "name": "Oleh Motrunych",
    "url": "https://github.com/oleh-motrunych"
  },
  "main": "dist/main.nodejs.js",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oleh-motrunych/scrypted-rtsp-viewer-plugin.git"
  },
  "keywords": [
    "scrypted",
    "plugin",
    "rtsp",
    "camera",
    "viewer"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/build.cjs",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "check": "npm run typecheck && npm run build && npm test",
    "preview": "node --import tsx test/preview.ts",
    "scrypted-login": "node scripts/scrypted-login.cjs",
    "scrypted-deploy": "node scripts/scrypted-deploy.cjs",
    "prepack": "npm run build"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.txt"
  ],
  "scrypted": {
    "name": "RTSP Live Viewer",
    "type": "API",
    "interfaces": [
      "Settings",
      "HttpRequestHandler",
      "Readme",
      "LauncherApplication"
    ]
  },
  "devDependencies": {
    "@scrypted/sdk": "0.5.61",
    "@types/node": "^22.0.0",
    "hls.js": "1.7.4",
    "readline-sync": "1.4.10",
    "terser-webpack-plugin": "^5.6.1",
    "tsx": "^4.20.0",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "@scrypted/sdk": {
      "adm-zip": "^0.6.1",
      "@rollup/plugin-terser": "^1.0.2"
    }
  }
}
